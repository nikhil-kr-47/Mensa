# Database
DB_URL=mongodb://127.0.0.1:27017/CampusBites

# Session & Auth
SESION_SECRET=your_session_secret_key_here
OTP_SECRET=your_otp_secret_key_here

# App URLs
ORG_URL=http://localhost:8080
LOCAL_URL=http://localhost:8080

# Cloudinary (Media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Services
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# Brevo / SendGrid (Optional Email APIs)
BREVO_SENDER_EMAIL=your_brevo_sender@domain.com
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_API_KEY=your_brevo_api_key
SENDGRID_API_KEY=your_sendgrid_api_key
