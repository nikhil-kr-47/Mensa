<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super admin dashboard — Mensa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..700&family=Instrument+Sans:wght@400..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/style.css">
</head>
<body class="superadmin-body">
    <header class="app-header">
        <div class="landing-nav">
            <a href="/Mensa.app" class="nav-brand">
                <span class="nav-brand-icon"><i class="fa-solid fa-burger"></i></span>
                <span class="nav-title">Mensa<span class="brand-dot"></span></span>
            </a>
            <div class="nav-actions">
                <span class="superadmin-badge">Super admin</span>
                <% if (typeof currUser !== 'undefined' && currUser) { %>
                    <a href="/Mensa.app/logout" class="btn-secondary btn-sm nav-auth-btn">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Log out</span>
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <main class="superadmin-main">
        <div class="superadmin-container">
            <section class="superadmin-overview">
                <div class="dash-header-row">
                    <div>
                        <h1 class="page-headline">Platform overview</h1>
                        <p class="dash-subhead">Manage canteen requests and active counters.</p>
                    </div>
                </div>

                <div class="stat-tiles-grid superadmin-stats">
                    <div class="stat-tile">
                        <span class="stat-num"><%= reqCnt %></span>
                        <span class="stat-label">Pending requests</span>
                    </div>
                    <div class="stat-tile">
                        <span class="stat-num" id="liveCnt"><%= liveCnt %></span>
                        <span class="stat-label">Live canteens</span>
                    </div>
                    <div class="stat-tile">
                        <span class="stat-num" id="pausedCnt"><%= pausedCnt %></span>
                        <span class="stat-label">Paused canteens</span>
                    </div>
                </div>
            </section>

            <section class="superadmin-section">
                <h3 class="section-heading">Pending requests</h3>
                <div class="superadmin-card-container">
                    <% if (reqs.length === 0) { %>
                        <div class="empty-orders-note">No pending canteen applications.</div>
                    <% } %>
                    <% for(let req of reqs) { %>
                        <div class="cant-req-card">
                            <div class="req-main-info">
                                <h4 class="req-title"><%= req.clgName %></h4>
                                <div class="req-sub-info"><%= req.location %></div>
                                <div class="req-contact-line"><%= req.username %>, <%= req.email %>, <%= req.phoneNo %></div>
                            </div>
                            <form class="approveRejectForm">
                                <input type="hidden" name="email" value="<%= req.email %>">
                                <div class="slug-prefix-input">
                                    <span class="slug-prefix">mensa.app/</span>
                                    <input type="text" name="slug" value="<%= req.slug %>" class="form-input slug-input" required>
                                </div>
                                <div class="req-action-btns">
                                    <button type="button" value="approve" class="btn-primary btn-sm superAdminActionBtn">Approve</button>
                                    <button type="button" value="reject" class="btn-destructive btn-sm superAdminActionBtn">Reject</button>
                                </div>
                            </form>
                        </div>
                    <% } %>
                </div>
            </section>

            <section class="superadmin-section">
                <h3 class="section-heading">All canteens</h3>
                <div class="superadmin-card-container">
                    <% if (cants.length === 0) { %>
                        <div class="empty-orders-note">No registered canteens found.</div>
                    <% } %>
                    <% for(let cant of cants) { %>
                        <div class="live-cant-card">
                            <div class="live-cant-info">
                                <div class="live-cant-name"><%= cant.clgName %></div>
                                <div class="live-cant-slug">mensa.app/<%= cant.slug %></div>
                                <div class="live-cant-email"><%= cant.email %></div>
                            </div>
                            <button type="button" class="toggle-btn" data-email="<%= cant.email %>" aria-label="Toggle canteen status">
                                <span class="toggle-ball <%= cant.isActive ? 'toggle-ball-active' : 'toggle-ball-pause' %>"></span>
                            </button>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </main>

    <%-include("../includes/footer")%>
    <script src="/script.js"></script>
</body>
</html>