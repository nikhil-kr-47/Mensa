<%layout("./layouts/bp.ejs")%>
<body>
<div class="auth-page-container">
    <div class="auth-header">
        <h1 class="page-headline">Set new password</h1>
        <p class="auth-subhead">Enter your updated password below to regain access.</p>
    </div>

    <div class="auth-card">
        <form action="/Mensa.app/resetPassword/<%= token %>" method="POST" class="auth-form">
            <div class="form-group">
                <label for="new-pass" class="form-label">New password</label>
                <input type="password" id="new-pass" name="newPassword" placeholder="At least 6 characters" class="form-input" required autofocus>
            </div>

            <div class="form-group">
                <label for="confirm-new-pass" class="form-label">Confirm new password</label>
                <input type="password" id="confirm-new-pass" name="confirmNewPassword" placeholder="Repeat new password" class="form-input" required>
                <span class="msgField form-error-msg"></span>
            </div>

            <button type="submit" id="reset-password-btn" class="btn-primary auth-submit-btn" disabled>
                Save new password
            </button>
        </form>
    </div>
</div>
</body>