<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register canteen — Mensa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..700&family=Instrument+Sans:wght@400..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="app-header">
        <div class="landing-nav">
            <a href="/Mensa.app" class="nav-brand">
                <span class="nav-brand-icon"><i class="fa-solid fa-burger"></i></span>
                <span class="nav-title">Mensa<span class="brand-dot"></span></span>
            </a>
            <div class="nav-actions">
                <a href="/Mensa.app" class="btn-secondary">
                    Back to home
                </a>
            </div>
        </div>
    </header>

    <%-include("../includes/flash.ejs")%>

    <div class="auth-page-container">
        <div class="auth-header">
            <h1 class="page-headline">Register your canteen</h1>
            <p class="auth-subhead">We will verify your college email and set up your live counter terminal.</p>
        </div>

        <div class="auth-card canteen-reg-card">
            <form method="POST" action="/Mensa.app/adminRegister" class="auth-form">
                <div class="form-group">
                    <label for="clgName" class="form-label">College or institute name</label>
                    <input type="text" name="clgName" id="clgName" placeholder="Indian Institute of Technology" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="location" class="form-label">Canteen location or campus block</label>
                    <input type="text" name="location" id="location" placeholder="Food court, Ground floor, Block A" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="username" class="form-label">Manager name</label>
                    <input type="text" name="username" id="username" placeholder="Ramesh Kumar" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">Official email address</label>
                    <input type="email" name="email" id="email" placeholder="canteen@institute.edu" class="form-input" required>
                </div>

                <div class="form-group">
                    <label for="phone" class="form-label">Contact phone number</label>
                    <input type="text" name="phoneNo" id="phone" placeholder="10-digit mobile number" class="form-input" required>
                </div>

                <button type="submit" class="btn-primary auth-submit-btn">
                    Submit application
                </button>
            </form>
        </div>
    </div>

    <%-include("../includes/footer.ejs")%>
    <script src="/script.js"></script>
</body>
</html>